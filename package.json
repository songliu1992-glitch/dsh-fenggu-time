{
  "name": "dsh-fenggu-time",
  "version": "0.1.1",
  "description": "Titlebar badge for DeepSeek Harness showing the current DeepSeek API pricing period: peak hours in yellow, off-peak hours in green (off-peak rates are half of the peak rates).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "badge",
    "china-holidays"
  ],
  "license": "MIT",
  "author": "dsh-fenggu-time contributors",
  "homepage": "https://github.com/songliu1992-glitch/dsh-fenggu-time#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songliu1992-glitch/dsh-fenggu-time.git"
  },
  "bugs": {
    "url": "https://github.com/songliu1992-glitch/dsh-fenggu-time/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "data",
    "assets/icon-180.png",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/client.test.mjs && node test/host.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
